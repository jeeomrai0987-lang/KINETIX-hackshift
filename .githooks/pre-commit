#!/usr/bin/env bash
set -e

# Block if any .env file is staged (except .env.example)
STAGED_ENV_FILES=$(git diff --cached --name-only | grep -iE '(^|/)\.env($|\.)' | grep -v '\.env\.example' || true)
if [ -n "$STAGED_ENV_FILES" ]; then
    echo "ERROR: Attempting to commit .env file:" >&2
    echo "$STAGED_ENV_FILES" >&2
    exit 1
fi

# Block if Google API key pattern (AIza...) is in staged additions
if git diff --cached -U0 | grep -E '^\+[^+]' | grep -qE 'AIza[0-9A-Za-z_-]{35}'; then
    echo "ERROR: Detected Google API key (AIza...) in staged changes. Commit aborted." >&2
    exit 1
fi

# Block if GEMINI_API_KEY with a non-empty value is in staged diff (outside .env.example)
NON_EXAMPLE_DIFF=$(git diff --cached -U0 -- . ':(exclude)*.env.example' | grep -E '^\+[^+]' || true)
if echo "$NON_EXAMPLE_DIFF" | grep -qE 'GEMINI_API_KEY\s*=\s*[^[:space:]]'; then
    echo "ERROR: Detected non-empty GEMINI_API_KEY in staged changes outside .env.example. Commit aborted." >&2
    exit 1
fi

exit 0
